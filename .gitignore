# C-oracle build output (built FROM the reference/svt-av1 submodule; the
# oracle lib lands in Bin/Release / Bin/ReleaseHdr, gates read it via
# SVT_CREF_LIB_DIR)
Bin
cbuild/
cbuild-static/
cbuild-static-hdr/
cbuild-config.log
cbuild-static-config.log
cbuild-static-hdr-config.log

# Committed test fixtures (lr_search_c_capture include_bytes! inputs, 4 KB each)
!rust/crates/svtav1-encoder/tests/data/*.bin

# Agent worktrees created by the Workflow tool (never committed).
.claude/

# Python bytecode. Importing rust/tools/fh_fields.py (or any other tool) as a
# module from an analysis snippet drops a ~31 KB .pyc in rust/tools/__pycache__
# — over the 30 KB "ask before committing a binary" line, in a directory whose
# sibling tests/data/*.bin fixtures are deliberately force-added, so a path
# glob would take it along.
__pycache__/
*.pyc
