# Local artifacts (never committed)
*.ivf
*.yuv
*.y4m
*.o
*.bin
*.log
.vscode
.cache/
.DS_Store
.workongoing
.jj/

# C-oracle build output (built FROM the reference/svt-av1 submodule; the
# oracle lib lands in Bin/Release / Bin/ReleaseHdr, gates read it via
# SVT_CREF_LIB_DIR)
Bin
cbuild/
cbuild-static/
cbuild-static-hdr/
cbuild-config.log
cbuild-static-config.log
cbuild-static-hdr-config.log

# Committed test fixtures (lr_search_c_capture include_bytes! inputs, 4 KB each)
!rust/crates/svtav1-encoder/tests/data/*.bin

# Agent worktrees created by the Workflow tool (never committed).
.claude/

# Python bytecode. `tools/fh_fields.py` etc. are imported as modules by ad-hoc
# analysis snippets, which drops a 31 KB .pyc beside them — one byte under the
# 30 KB "ask before committing a binary" line, and easy to `jj commit` by
# accident with a path glob.
__pycache__/
*.pyc
