  six still cells                290/839/63/171/580/693 B   290/839/63/171/580/693 B
  regression_spotcheck                        104 / 104              104 / 104
  fctx_gate                       96/96 fields, PASS       96/96 fields, PASS
  screen_ibc_byte_gate            152 / 152, 0 diverging   152 / 152, 0 diverging
  screen_palette_gate             50 / 50 (38 palette)     50 / 50 (38 palette)
  inter_byte_gate                 108 required, 0 failed   108 required, 0 failed
  video_key_matrix                59 / 60 (1 known diff)   59 / 60 (1 known diff)
  SCAN_GATE (inter_completion)    64 OK / 0 REFUSED /      64 OK / 0 REFUSED /
                                  0 CRASH, PASS            0 CRASH, PASS
  decode_conformance              1260 passed, 0 failed    1260 passed, 0 failed
  identity_full_8bit              1100 / 1100, +0 pinned,  1100 / 1100, +0 pinned,
                                  0 harness errors         0 harness errors
