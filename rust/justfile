# SVT-AV1 Rust port build commands

# Default recipe
default: check

# Check all crates compile
check:
    cargo check --workspace

# Build all crates
build:
    cargo build --workspace

# Run all tests.
#
# nextest, NOT `cargo test`, is the runner — same as CI (.github/workflows/
# rust-gates.yml). It runs each test in its OWN PROCESS, which structurally
# removes the archmage hazard: token disabling
# (`for_each_token_permutation` -> `dangerously_disable_token_process_wide`)
# is PROCESS-WIDE, so under a shared-process runner one test can flip the
# dispatch tier underneath another. Tests that must observe a stable tier also
# hold `archmage::testing::lock_token_testing()` so `cargo test` stays correct,
# but nextest is what the gates are defined against.
#
# nextest does not run doctests; the workspace has 2, so the `--doc`
# pass below is load-bearing, not just a guard.
test:
    cargo nextest run --workspace
    cargo test --workspace --doc

# Run tests with all features EXCEPT `symtrace`.
#
# `symtrace` puts an unbuffered `std::eprintln!` on the arithmetic coder's
# PER-SYMBOL path (crates/svtav1-encoder/src/entropy/range_coder.rs). Enabling it
# for the test suite costs a measured 16.9x with zero verification value:
#
#   --all-features            287.4 s   2650 tests   (2026-09-09, i265)
#   all-except-symtrace        17.3 s   2650 tests
#
#   ...one test alone, issue18_bd10_forced_by_area_portrait_recon_matches_aomdec,
#   goes 9.4 s -> 284.8 s purely from the per-symbol writes.
#
# The SAME 2650 tests run either way: the 11 tests that `--all-features` adds over
# the default set come from `avif-container` and `fallible-alloc`, not `symtrace`
# (verified by diffing the two nextest test lists). No `#[test]` anywhere is gated
# on `symtrace`; its only consumers are the eight gate scripts that build
# `--example identity_run --features symtrace` to diff the trace against C.
#
# `symtrace-check` below still COMPILES it, so the feature cannot bit-rot.
test-all:
    cargo nextest run --workspace --features zenav1-svt/avif-container,zenav1-svt/fallible-alloc,zenav1-svt/unsafe_encoding,zenav1-svt-dsp/avx512,zenav1-svt-dsp/unchecked_dsp,zenav1-svt-encoder/unchecked_entropy
    cargo test --workspace --features zenav1-svt/avif-container,zenav1-svt/fallible-alloc,zenav1-svt/unsafe_encoding --doc

# Compile-only guard so `symtrace` cannot rot while it is kept out of test-all.
symtrace-check:
    cargo check --workspace --all-features --all-targets

# Run tests with no default features
test-minimal:
    cargo nextest run --workspace --no-default-features

# Format and lint
fmt:
    cargo fmt --all

# Clippy lint
clippy:
    cargo clippy --workspace --all-targets -- -D warnings

# Local CI sanity check
ci: fmt clippy test test-all test-minimal symtrace-check

# Alignment / stride gate — the CI subset (74 cells, ~4 min).
# true-vs-aligned on each axis at every residue mod 8, dims straddling 64,
# odd dims (ceiling chroma), a poisoned padded luma stride, bd8 + bd10.
# Two oracles per cell: byte-identity to C, and encoder-recon == aomdec.
align-gate:
    ALIGN_GATE_MODE=fast ./tools/alignment_gate.sh

# The FULL sweep — same shapes across presets 0..13 and qp 12/55, plus bd10
# breadth. Not in CI (minutes, not seconds). Run it after any change to frame
# geometry, TRUE->ALIGNED padding, the deblock/CDEF/LR extents, or the intra
# reference edges.
align-gate-full:
    ALIGN_GATE_MODE=full ./tools/alignment_gate.sh

# Native lossless source samples and C streams, retaining every cell's artifacts.
native-lossless-gate out:
    TMPDIR="$HOME/tmp" ~/work/claudehints/scripts/run-heavy --mem 16G --jobs 4 -- python3 tools/native_lossless_gate.py "{{out}}"

# Diagnostic integrity: palette mismatches must be visible in tree comparisons.
tree-diff-test:
    TMPDIR="$HOME/tmp" python3 tools/test_tree_diff.py

# Run benchmarks
bench:
    cargo bench --workspace

# Prebuilt API-timed drivers, explicit per-size real inputs, every sample byte-checked.
# reference_kind=port supports same-binary controls and port A/B experiments.
still-pairs port reference cells out cpu="2" rounds="21" reference_kind="c":
    TMPDIR="$HOME/tmp" ~/work/claudehints/scripts/run-heavy --jobs 4 -- python3 tools/perf_profile/still_pairs.py --port "{{port}}" --reference "{{reference}}" --reference-kind "{{reference_kind}}" --cells "{{cells}}" --out "{{out}}" --cpu "{{cpu}}" --rounds "{{rounds}}"

# Check for semver violations
semver:
    cargo semver-checks check-release --workspace

# Generate docs
doc:
    cargo doc --workspace --no-deps --open

# Bitstream-identity harness vs C SVT-AV1 (report: docs/IDENTITY-STATUS.md)
identity w="64" h="64" qp="40" preset="13" content="uniform":
    tools/identity_diff.sh {{w}} {{h}} {{qp}} {{preset}} {{content}}

# Real-image identity matrix vs C SVT-AV1 on CID22-512 photos (report:
# benchmarks/real_image_identity_<suffix>.tsv). Env-overridable: RIM_CORPUS,
# RIM_IMAGES, RIM_PRESETS, RIM_QPS, RIM_CELL_TIMEOUT (see the script header).
real-identity suffix="latest":
    tools/real_image_matrix.sh {{suffix}}

# Recon-parity gate for the MAINLINE variance-boost per-SB delta-q path
# (tune IQ => enable_variance_boost, qp >= 20 => delta_q_res >= 2). Proves the
# planned SB qindexes survive the pack's truncating (cur-prev)/delta_q_res and
# the decoder's prev + reduced*delta_q_res accumulator. Needs aomdec (AOMDEC=).
variance-boost-recon outdir="target/variance_boost_recon":
    tools/variance_boost_recon.sh {{outdir}}

# Paired runtime tiers; filter is a group-name substring (empty runs all).
arm-kernel-audit filter="":
    CARGO_BUILD_JOBS=4 RAYON_NUM_THREADS=4 OMP_NUM_THREADS=4 TMPDIR="$HOME/tmp" nice -n 19 cargo bench -p zenav1-svt-dsp --bench kernel_tiers -- --group="{{filter}}"

# Old quality-program regressions and shipping-refusal inventory.
quality-program-check:
    cargo test -p zenav1-svt-types --no-default-features
    cargo nextest run -p zenav1-svt-encoder -E 'test(cancellation_tests) | test(invalid_builders) | test(untileable) | test(tile_log2_blk)'
    python3 tools/test_refusal_inventory.py
    bash tools/refusal_inventory.sh --check

# Run under the shared run-heavy wrapper, as for other benchmark recipes.
cancel-latency preset="8" out="benchmarks/cancel_latency_local.tsv":
    cargo run --release -p zenav1-svt --example cancel_latency -- --sizes 64,256,1024,4096 --preset {{preset}} --points 12 --reps 2 --baseline-reps 2 --out {{out}}

# Same-binary frozen handwritten ARM kernels versus magetypes compositions.
arm-pairwise:
    CARGO_BUILD_JOBS=4 RAYON_NUM_THREADS=4 OMP_NUM_THREADS=4 TMPDIR="$HOME/tmp" nice -n 19 cargo bench -p zenav1-svt-dsp --bench kernel_tiers -- --group=arm_pairwise

# Register-only narrow-row experiment, separate from production kernels.
arm-rowpack:
    CARGO_BUILD_JOBS=4 RAYON_NUM_THREADS=4 OMP_NUM_THREADS=4 TMPDIR="$HOME/tmp" nice -n 19 cargo bench -p zenav1-svt-dsp --bench kernel_tiers -- --group=arm_rowpack
