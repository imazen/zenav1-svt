# SVT-AV1 Rust port build commands

# Default recipe
default: check

# Check all crates compile
check:
    cargo check --workspace

# Build all crates
build:
    cargo build --workspace

# Run all tests.
#
# nextest, NOT `cargo test`, is the runner — same as CI (.github/workflows/
# rust-gates.yml). It runs each test in its OWN PROCESS, which structurally
# removes the archmage hazard: token disabling
# (`for_each_token_permutation` -> `dangerously_disable_token_process_wide`)
# is PROCESS-WIDE, so under a shared-process runner one test can flip the
# dispatch tier underneath another. Tests that must observe a stable tier also
# hold `archmage::testing::lock_token_testing()` so `cargo test` stays correct,
# but nextest is what the gates are defined against.
#
# nextest does not run doctests; the workspace has 2, so the `--doc`
# pass below is load-bearing, not just a guard.
test:
    cargo nextest run --workspace
    cargo test --workspace --doc

# Run tests with all features
test-all:
    cargo nextest run --workspace --all-features
    cargo test --workspace --all-features --doc

# Run tests with no default features
test-minimal:
    cargo nextest run --workspace --no-default-features

# Format and lint
fmt:
    cargo fmt --all

# Clippy lint
clippy:
    cargo clippy --workspace --all-targets -- -D warnings

# Local CI sanity check
ci: fmt clippy test test-all test-minimal

# Alignment / stride gate — the CI subset (74 cells, ~4 min).
# true-vs-aligned on each axis at every residue mod 8, dims straddling 64,
# odd dims (ceiling chroma), a poisoned padded luma stride, bd8 + bd10.
# Two oracles per cell: byte-identity to C, and encoder-recon == aomdec.
align-gate:
    ALIGN_GATE_MODE=fast ./tools/alignment_gate.sh

# The FULL sweep — same shapes across presets 0..13 and qp 12/55, plus bd10
# breadth. Not in CI (minutes, not seconds). Run it after any change to frame
# geometry, TRUE->ALIGNED padding, the deblock/CDEF/LR extents, or the intra
# reference edges.
align-gate-full:
    ALIGN_GATE_MODE=full ./tools/alignment_gate.sh

# Run benchmarks
bench:
    cargo bench --workspace

# Prebuilt API-timed drivers, explicit per-size real inputs, every sample byte-checked.
# reference_kind=port supports same-binary controls and port A/B experiments.
still-pairs port reference cells out cpu="2" rounds="21" reference_kind="c":
    TMPDIR="$HOME/tmp" ~/work/claudehints/scripts/run-heavy --jobs 4 -- python3 tools/perf_profile/still_pairs.py --port "{{port}}" --reference "{{reference}}" --reference-kind "{{reference_kind}}" --cells "{{cells}}" --out "{{out}}" --cpu "{{cpu}}" --rounds "{{rounds}}"

# Check for semver violations
semver:
    cargo semver-checks check-release --workspace

# Generate docs
doc:
    cargo doc --workspace --no-deps --open

# Bitstream-identity harness vs C SVT-AV1 (report: docs/IDENTITY-STATUS.md)
identity w="64" h="64" qp="40" preset="13" content="uniform":
    tools/identity_diff.sh {{w}} {{h}} {{qp}} {{preset}} {{content}}

# Real-image identity matrix vs C SVT-AV1 on CID22-512 photos (report:
# benchmarks/real_image_identity_<suffix>.tsv). Env-overridable: RIM_CORPUS,
# RIM_IMAGES, RIM_PRESETS, RIM_QPS, RIM_CELL_TIMEOUT (see the script header).
real-identity suffix="latest":
    tools/real_image_matrix.sh {{suffix}}

# Recon-parity gate for the MAINLINE variance-boost per-SB delta-q path
# (tune IQ => enable_variance_boost, qp >= 20 => delta_q_res >= 2). Proves the
# planned SB qindexes survive the pack's truncating (cur-prev)/delta_q_res and
# the decoder's prev + reduced*delta_q_res accumulator. Needs aomdec (AOMDEC=).
variance-boost-recon outdir="target/variance_boost_recon":
    tools/variance_boost_recon.sh {{outdir}}

# Paired runtime tiers; filter is a group-name substring (empty runs all).
arm-kernel-audit filter="":
    CARGO_BUILD_JOBS=4 RAYON_NUM_THREADS=4 OMP_NUM_THREADS=4 TMPDIR="$HOME/tmp" nice -n 19 cargo bench -p zenav1-svt-dsp --bench kernel_tiers -- --group="{{filter}}"
